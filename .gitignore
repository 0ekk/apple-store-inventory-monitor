# Rust
/target/
**/*.rs.bk

# 前端
node_modules
/dist
dist-ssr
*.local

# 日志
logs
*.log
npm-debug.log*
pnpm-debug.log*

# Tauri 更新签名私钥。绝对不能提交 —— 泄露等于任何人都能给你的用户推送
# 一个"合法签名"的更新包。
*.key
/.tauri/

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.swp
*.sw?

# 生成快照的脚本留下的字节码缓存
__pycache__/

# Headless deployment data: the user's settings.v2.json (Bark device key,
# monitor list) bind-mounted into the container. Never commit this.
/deploy/data/
/deploy/.env
# Headless web UI build output (crates/apw-headless/web/vite.config.ts).
/crates/apw-headless/web/dist/
